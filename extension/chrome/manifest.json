{
  "manifest_version": 3,
  "name": "Qorvex",
  "version": "1.0.1",
  "description": "Send downloads and videos to Qorvex, which downloads over all your connections at once.",
  "permissions": [
    "downloads",
    "contextMenus",
    "cookies",
    "storage",
    "webRequest",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Qorvex"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true
    }
  ]
}
