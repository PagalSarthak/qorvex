{
  "manifest_version": 2,
  "name": "Qorvex",
  "version": "0.2.0",
  "description": "Send downloads and videos to Qorvex, which downloads over all your connections at once.",
  "permissions": ["downloads", "contextMenus", "cookies", "storage", "webRequest", "tabs", "<all_urls>"],
  "background": { "scripts": ["background.js"] },
  "browser_action": { "default_popup": "popup.html", "default_title": "Qorvex" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true }],
  "browser_specific_settings": { "gecko": { "id": "qorvex@local", "strict_min_version": "91.0", "data_collection_permissions": { "required": ["none"] } } }
}
